# ClaudeBrigade Environment Variables
# Copy this file to ~/.config/claude-brigade/providers.env and fill in your keys.
# See install.sh and the README for setup instructions.

# Required: API key for FreeInference (primary external backend)
# FREEINFERENCE_API_KEY='your-key-here'
# Optional: override the shared FreeInference concurrency limit for this launch.
# This sets both active-agent and in-flight request capacity.
# FREEINFERENCE_MAX_CONCURRENCY=4

# Required: Internal auth token for the loopback router
# Generate with: openssl rand -hex 32
# ENHANCED_ROUTER_TOKEN='your-token-here'

# Optional: LiteLLM master key (auto-generated if not set)
# BRIGADE_LITELLM_KEY='your-litellm-key'

# Optional: Override default profile and workflow for new sessions
# BRIGADE_DEFAULT_PROFILE=hybrid
# BRIGADE_DEFAULT_WORKFLOW=normal

# Optional: API keys for alternate backends
# DEEPSEEK_API_KEY='your-key-here'
# OPENROUTER_API_KEY='your-key-here'
# GLM_API_KEY='your-key-here'
# ANTHROPIC_API_KEY='your-key-here'

# LongCat (Anthropic-compatible endpoint)
# LONGCAT_API_KEY='your-key-here'
# LONGCAT_API_BASE='https://api.longcat.chat/anthropic'

# Optional: Override XDG base directories
# BRIGADE_STATE_DIR=~/.local/state/claude-brigade
# BRIGADE_CACHE_DIR=~/.cache/claude-brigade
# BRIGADE_CONFIG_DIR=~/.config/claude-brigade

# Optional: Override the loopback router port
# CLAUDE_ENHANCED_PORT=8787
