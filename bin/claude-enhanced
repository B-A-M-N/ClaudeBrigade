#!/usr/bin/env bash
set -euo pipefail

PROFILE_DIR="${CLAUDE_ENHANCED_CONFIG_DIR:-$HOME/.claude-enhanced}"
APP_DIR="${CLAUDE_ENHANCED_APP_DIR:-$HOME/.local/share/claude-enhanced}"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/claude-enhanced/longcat.env"
TOKEN_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/claude-enhanced/router.token"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/claude-enhanced"
PORT_FILE="$CACHE_DIR/router.port"
_PREFERRED_PORT="${CLAUDE_ENHANCED_PORT:-8787}"

# find_free_port: returns the first available TCP port >= $1
find_free_port() {
  python3 - "$1" <<'PY'
import socket, sys
start = int(sys.argv[1])
for port in range(start, start + 200):
    try:
        with socket.socket() as s:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind(('127.0.0.1', port))
        print(port)
        sys.exit(0)
    except OSError:
        pass
sys.exit('No free port found in range')
PY
}

mkdir -p "$CACHE_DIR"

# Resolve port: honour an explicit env override, then try the saved port
# from a previous run, then fall back to auto-discovery.
if [[ -n "${CLAUDE_ENHANCED_PORT:-}" ]]; then
  PORT="$CLAUDE_ENHANCED_PORT"
elif [[ -f "$PORT_FILE" ]]; then
  PORT="$(cat "$PORT_FILE")"
else
  PORT="$_PREFERRED_PORT"
fi

if [[ ! -r "$ENV_FILE" ]]; then
  echo "Missing $ENV_FILE. Add LONGCAT_API_KEY='...' and chmod 600 it." >&2
  exit 1
fi
LONGCAT_API_KEY="$(python3 - "$ENV_FILE" <<'PY'
import pathlib
import shlex
import sys

path = pathlib.Path(sys.argv[1])
value = ""
for raw in path.read_text(encoding="utf-8").splitlines():
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    if not line.startswith("LONGCAT_API_KEY="):
        raise SystemExit("longcat.env may contain only LONGCAT_API_KEY=...")
    if value:
        raise SystemExit("longcat.env contains duplicate LONGCAT_API_KEY entries")
    encoded = line.split("=", 1)[1].strip()
    parts = shlex.split(encoded, comments=False, posix=True)
    value = parts[0] if len(parts) == 1 else encoded
print(value)
PY
)"
if [[ -z "$LONGCAT_API_KEY" || "$LONGCAT_API_KEY" == "replace_me" ]]; then
  echo "Set LONGCAT_API_KEY in $ENV_FILE first." >&2
  exit 1
fi
if [[ ! -r "$TOKEN_FILE" ]]; then
  echo "Missing router token. Re-run the installer." >&2
  exit 1
fi
ROUTER_TOKEN="$(cat "$TOKEN_FILE")"
# (CACHE_DIR already created above)

health_url="http://127.0.0.1:${PORT}/healthz"
if ! curl -fsS -H "X-Enhanced-Token: $ROUTER_TOKEN" "$health_url" > /dev/null 2>&1; then
  # Port may be taken by something else; find a genuinely free one.
  PORT="$(find_free_port "$_PREFERRED_PORT")"
  echo "$PORT" > "$PORT_FILE"
  health_url="http://127.0.0.1:${PORT}/healthz"
  nohup env \
    LONGCAT_API_KEY="$LONGCAT_API_KEY" \
    ENHANCED_ROUTER_TOKEN="$ROUTER_TOKEN" \
    PYTHONPATH="$APP_DIR/router" \
    "$APP_DIR/venv/bin/python" -m uvicorn enhanced_router.app:app \
      --host 127.0.0.1 --port "$PORT" --no-access-log \
      >"$CACHE_DIR/router.log" 2>&1 &
  echo $! >"$CACHE_DIR/router.pid"
  for _ in {1..50}; do
    if curl -fsS -H "X-Enhanced-Token: $ROUTER_TOKEN" "$health_url" > /dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done
else
  # Running router found; record the port so it survives restarts.
  echo "$PORT" > "$PORT_FILE"
fi
if ! curl -fsS -H "X-Enhanced-Token: $ROUTER_TOKEN" "$health_url" > /dev/null 2>&1; then
  echo "Router failed to start. See $CACHE_DIR/router.log" >&2
  exit 1
fi

unset LONGCAT_API_KEY
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_MODEL
unset ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_FABLE_MODEL
unset CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CODE_SUBAGENT_MODEL CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY
export CLAUDE_CODE_FORK_SUBAGENT=0
export CLAUDE_CONFIG_DIR="$PROFILE_DIR"
ROUTER_BASE_URL="http://127.0.0.1:${PORT}"

SESSION_SETTINGS_JSON="$(
  python3 - "$ROUTER_BASE_URL" <<'PY'
import json
import sys

print(json.dumps({
    "env": {
        "ANTHROPIC_BASE_URL": sys.argv[1],
    }
}))
PY
)"

export ANTHROPIC_BASE_URL="$ROUTER_BASE_URL"
export ANTHROPIC_CUSTOM_HEADERS="X-Enhanced-Token: ${ROUTER_TOKEN}"

for argument in "$@"; do
  case "$argument" in
    --agent|--agent=*|--agents|--agents=*|--model|--model=*|--fallback-model|--fallback-model=*|--system-prompt|--system-prompt=*|--system-prompt-file|--system-prompt-file=*|--append-system-prompt-file|--append-system-prompt-file=*|--settings|--settings=*|--setting-sources|--setting-sources=*|--permission-mode|--permission-mode=*|--dangerously-skip-permissions|--allow-dangerously-skip-permissions)
      echo "claude-enhanced owns $argument to preserve the controller and routing contract." >&2
      echo "Use the normal 'claude' command when you need to override those session controls." >&2
      exit 2
      ;;
  esac
done

AGENTS_JSON="$(
  PYTHONPATH="$APP_DIR/router"     "$APP_DIR/venv/bin/python" -m enhanced_router.agents_json "$PROFILE_DIR/agents"
)"

exec claude \
  --settings "$SESSION_SETTINGS_JSON" \
  --agents "$AGENTS_JSON" \
  --append-system-prompt-file "$PROFILE_DIR/controller-append.md" \
  "$@"
