#!/usr/bin/env bash
set -euo pipefail
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/claude-enhanced"
PID_FILE="$CACHE_DIR/router.pid"
if [[ -f "$PID_FILE" ]]; then
  pid="$(cat "$PID_FILE")"
  if kill -0 "$pid" 2>/dev/null; then
    cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
    if [[ "$cmdline" == *"enhanced_router.app:app"* ]]; then
      kill "$pid"
    else
      echo "Refusing to kill PID $pid because it is not the enhanced router." >&2
      exit 1
    fi
  fi
  rm -f "$PID_FILE"
fi
