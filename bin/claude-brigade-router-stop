#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# ClaudeBrigade router stop script
#
# Canonical path resolution matches the launcher (bin/claude-brigade) and
# the Python base module.  Uses BRIGADE_CACHE_DIR with the same fallback
# chain so the stop script always finds the files the launcher wrote.
#
# Responsibility boundary:
#   - The launcher (claude-brigade) owns starting the router and writing
#     router.pid + router.port.
#   - The router supervisor (LiteLLMSupervisor) owns shutdown of all
#     LiteLLM child processes.
#   - This script only stops the router gateway itself, with identity
#     validation to prevent killing a rogue PID.
# ---------------------------------------------------------------------------

CACHE_DIR="${BRIGADE_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/claude-brigade}"
PID_FILE="$CACHE_DIR/router.pid"

if [[ -f "$PID_FILE" ]]; then
  pid="$(cat "$PID_FILE")"
  if kill -0 "$pid" 2>/dev/null; then
    cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
    if [[ "$cmdline" == *"enhanced_router.app:app"* ]]; then
      kill "$pid"
    else
      echo "Refusing to kill PID $pid because it is not the enhanced router." >&2
      exit 1
    fi
  fi
  rm -f "$PID_FILE"
fi
